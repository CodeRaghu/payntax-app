# Local development only. Fake values. Run `make env` to create .env with fresh keys.
DJANGO_ENV=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
FIELD_ENCRYPTION_KEYS=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

POSTGRES_DB=payntax
POSTGRES_USER=payntax
POSTGRES_PASSWORD=payntax-local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# SeaweedFS stands in for S3 locally. The browser uploads to S3_PUBLIC_ENDPOINT_URL.
AWS_ACCESS_KEY_ID=payntax
AWS_SECRET_ACCESS_KEY=payntax-local-secret
AWS_REGION=us-east-2
S3_BUCKET=payntax-documents
S3_ENDPOINT_URL=http://s3:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

BILLING_PROVIDER=apps.billing.providers.FakeBillingProvider
FRONTEND_URL=http://localhost:3000

# Frontend: where the Next.js server proxies /api. Set NEXT_PUBLIC_API_MOCKING=enabled to run the UI on mocks.
API_PROXY_TARGET=http://backend:8000
NEXT_PUBLIC_API_MOCKING=disabled
